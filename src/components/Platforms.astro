---
const fleet = [
  { number: "01", type: "Omnidirectional platform", name: "ROSMASTER X3 (x4)", tag: "Jetson Orin NX", image: "https://drive.google.com/file/d/1IqohzH9B_L3g7itCVkBn9pzQgt0BVlCg/preview" },
  { number: "02", type: "Ackermann steering", name: "ROSMASTER R2 (x2)", tag: "Vehicle control", embed: "https://drive.google.com/file/d/1vnB2DXt-_Q9jP4zXdz0ws5t0l9TzSQI6/preview" },
  { number: "03", type: "Autonomous vehicle", name: "Rova-M (x2)", tag: "Vehicle platform", embed: "https://drive.google.com/file/d/1-k_2t4jU0A0x0m6mm6ahUJ_QzHc_kybY/preview" },
  { number: "04", type: "Autonomous vehicle", name: "Research Vehicle 04", tag: "Vehicle platform", embed: "https://drive.google.com/file/d/1L2M3N4O5P6Q7R8S9T0U1V2W3X4Y5Z6A/preview" },
  { number: "05", type: "Autonomous vehicle", name: "Research Vehicle 05", tag: "Vehicle platform", embed: "https://drive.google.com/file/d/1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6Q/preview" },
  { number: "06", type: "Autonomous vehicle", name: "Research Vehicle 06", tag: "Vehicle platform", embed: "https://drive.google.com/file/d/1R2S3T4U5V6W7X8Y9Z0A1B2C3D4E5F6G/preview" },
  { number: "07", type: "Autonomous vehicle", name: "Research Vehicle 07", tag: "Vehicle platform", embed: "https://drive.google.com/file/d/1H2I3J4K5L6M7N8O9P0Q1R2S3T4U5V6W/preview" },
  { number: "08", type: "Autonomous vehicle", name: "Research Vehicle 08", tag: "Vehicle platform", embed: "https://drive.google.com/file/d/1X2Y3Z4A5B6C7D8E9F0G1H2I3J4K5L6M/preview" },
  { number: "09", type: "Autonomous vehicle", name: "Research Vehicle 09", tag: "Vehicle platform", embed: "https://drive.google.com/file/d/1N2O3P4Q5R6S7T8U9V0W1X2Y3Z4A5B6C/preview" },
  { number: "10", type: "Simulator equipment", name: "CARLA + Driving Rig", tag: "Repeatable scenarios", embed: "https://drive.google.com/file/d/1A2B3C4D5E6F7G8H9I0J1K2L3M4N5O6P/preview" },
  { number: "11", type: "Simulator equipment", name: "Simulation Workstation", tag: "Digital twin", embed: "https://drive.google.com/file/d/1Q2R3S4T5U6V7W8X9Y0Z1A2B3C4D5E6F/preview" },
  { number:="12", type: "Simulator equipment", name:="Steering Controller", tag:=("Vehicle control"), embed:=("https://drive.google.com/file/d/1G2H3I4J5K6L7M8N9O0P1Q2R3S4T5U6V/preview") },
  { number="13", type:=("Simulator equipment"), name:=("Pedal Interface"), tag:=("Driver input"), embed:=("https://drive.google.com/file/d/1W2X3Y4Z5A6B7C8D9E0F1G2H3I4J5K6L/preview") },
  { number="14", type:=("Simulator equipment"), name:=("Motion Platform"), tag:=("Dynamic testing"), embed:=("https://drive.google.com/file/d/1M2N3O4P5Q6R7S8T9U0V1W2X3Y4Z5A6B/preview") },
  { number: "15", type: "Simulator equipment", name: "Sensor Replay Station", tag: "Data playback", embed: "https://drive.google.com/file/d/1C2D3E4F5G6H7I8J9K0L1M2N3O4P5Q6R/preview" },
  { number: "16", type: "Simulator equipment", name: "Scenario Display", tag: "Visual simulation", embed: "https://drive.google.com/file/d/1D2E3F4G5H6I7J8K9L0M1N2O3P4Q5R6S/preview" },
];
---

<section class="platforms" id="platforms">
  <div class="section-shell">
    <div class="section-heading-row">
      <div><p class="section-kicker">Research platforms</p><h2>Meet the fleet.</h2></div>
      
    </div>
    <div class="fleet-grid">
      {fleet.map((item) => (
        <article class="fleet-card">
          <div class="fleet-media">
            {item.embed ? (
              <iframe src={item.embed} title={item.name} loading="lazy"></iframe>
            ) : item.image ? (
              <img src={item.image} alt={`${item.name} research vehicle`} width="1200" height="800" loading="lazy" />
            ) : (
              <div class:list={["fleet-art", { "sim-art": item.type === "Simulator equipment" }]}><span>{item.number}</span></div>
            )}
          </div>
          <div class="fleet-copy">
            <div class="fleet-copy-topline"><span class="number">{item.number}</span><span class="tag dark">{item.tag}</span></div>
            <p>{item.type}</p>
            <h3>{item.name}</h3>
            <small>{item.type === "Simulator equipment" ? "Simulation and validation equipment for repeatable autonomy testing." : "Research vehicle supporting perception, planning, and control experiments."}</small>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
