---
const fleet = [
  { number: "01", type: "Omnidirectional platform", name: "ROSMASTER X3 (x4)", tag: "Jetson Orin NX / Orin Nano / NX 4G-8G", embed: "https://drive.google.com/file/d/1IqohzH9B_L3g7itCVkBn9pzQgt0BVlCg/preview" },
  { number: "02", type: "Ackermann steering", name: "ROSMASTER R2 (x2)", tag: "Jetson Orin Nano / Orin NX", embed: "https://drive.google.com/file/d/1vnB2DXt-_Q9jP4zXdz0ws5t0l9TzSQI6/preview" },
  { number: "03", type: "Autonomous vehicle", name: "Rova-M (x2)", tag: "Vehicle platform", embed: "https://drive.google.com/file/d/1-k_2t4jU0A0x0m6mm6ahUJ_QzHc_kybY/preview" },
  { number: "04", type: "Autonomous vehicle", name: "RobiX Robot (RovaX)", tag: "Vehicle platform", embed:"https://drive.google.com/file/d/1S0Sf4E_7cdadIe6lYLVsGByaXR0PkTB6/preview" },
  { number: "05", type: "RSU", name: "Roadside Unit", tag: "RSU", embed: "https://drive.google.com/file/d/167ieX0f4BONLetq3dJxD2imL4V-he2c2/preview" },
  { number: "06", type: "GPU", name: "Alienware Aurora RTX 5090", tag: "Workstation", embed: "https://drive.google.com/file/d/14Co9V-3BBErqFMxLquF0760eKaJXhWze/preview" },
  { number: "07", type: "GPU", name: "Alienware Aurora RTX 2080 Ti", tag: "Workstation", embed: "https://drive.google.com/file/d/1g0k5J6X8Z2x3F7z5G9y4J6X8Z2x3F7z5/preview" },
  { number: "08", type: "GPU", name: "Alienware Aurora RTX 3080", tag: "Workstation", embed: "https://drive.google.com/file/d/1g0k5J6X8Z2x3F7z5G9y4J6X8Z2x3F7z5/preview" },
  { number: "09", type: "GPU", name: "Alienware Aurora RTX 3090", tag: "Workstation", embed: "https://drive.google.com/file/d/1WR3iy0pmT4jkivAsd73AiSWDGoyY6Fe0/preview" },
  { number: "10", type: "Simulator equipment", name: "CARLA + Driving Rig", tag: "Repeatable scenarios" },
  { number: "11", type: "Simulator equipment", name: "Simulation Workstation", tag: "Digital twin" },
  { number: "12", type: "Simulator equipment", name: "Steering Controller", tag: "Vehicle control" },
  { number: "13", type: "Simulator equipment", name: "Pedal Interface", tag: "Driver input" },
  { number: "14", type: "Simulator equipment", name: "Motion Platform", tag: "Dynamic testing" },
  { number: "15", type: "Simulator equipment", name: "Sensor Replay Station", tag: "Data playback" },
  { number: "16", type: "Simulator equipment", name: "Scenario Display", tag: "Visual simulation" },
  { number: "08", type: "Autonomous vehicle", name: "Research Vehicle 08", tag: "Vehicle platform" },
  { number: "09", type: "Autonomous vehicle", name: "Research Vehicle 09", tag: "Vehicle platform" },
  { number: "10", type: "Simulator equipment", name: "CARLA + Driving Rig", tag: "Repeatable scenarios" },
  { number: "11", type: "Simulator equipment", name: "Simulation Workstation", tag: "Digital twin" },
  { number: "12", type: "Simulator equipment", name: "Steering Controller", tag: "Vehicle control" },
  { number: "13", type: "Simulator equipment", name: "Pedal Interface", tag: "Driver input" },
  { number: "14", type: "Simulator equipment", name: "Motion Platform", tag: "Dynamic testing" },
  { number: "15", type: "Simulator equipment", name: "Sensor Replay Station", tag: "Data playback" },
  { number: "16", type: "Simulator equipment", name: "Scenario Display", tag: "Visual simulation" },
];
---

<section class="platforms" id="platforms">
  <div class="section-shell">
    <div class="section-heading-row">
      <div><p class="section-kicker">Research platforms</p><h2>Meet the fleet.</h2></div>
      
    </div>
    <div class="fleet-grid">
      {fleet.map((item) => (
        <article class="fleet-card">
          <div class="fleet-media">
            {item.embed ? (
              <iframe src={item.embed} title={item.name} loading="lazy"></iframe>
            ) : item.image ? (
              <img src={item.image} alt={`${item.name} research vehicle`} width="1200" height="800" loading="lazy" />
            ) : (
              <div class:list={["fleet-art", { "sim-art": item.type === "Simulator equipment" }]}><span>{item.number}</span></div>
            )}
          </div>
          <div class="fleet-copy">
            <div class="fleet-copy-topline"><span class="number">{item.number}</span><span class="tag dark">{item.tag}</span></div>
            <p>{item.type}</p>
            <h3>{item.name}</h3>
            <small>{item.type === "Simulator equipment" ? "Simulation and validation equipment for repeatable autonomy testing." : "Research vehicle supporting perception, planning, and control experiments."}</small>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
