---
const driveImage = (fileId) =>
	`https://drive.google.com/thumbnail?id=${fileId}&sz=w1600`;

const milestonePhotos = [
	{
		src: driveImage('1n2xz9FJ154pdeU-Lt7iw3xk5UujvN8P7'),
		alt: 'Robot vehicle prepared for a research milestone',
		caption: 'Team 01',
	},
	{
		src: driveImage('1sRknQDcbOrGfV-_AeYFp0hRkK9gid1EF'),
		alt: 'Autonomous research vehicle',
		caption: 'Team 02',
	},
	{
		src: driveImage('16mSPEcpeoReLfRCrOz8_FuCJd4GxP-jy'),
		alt: 'Outdoor vehicle computing testbed',
		caption: 'Team 03',
	},
	{
		src: driveImage('17ZwRj6Cij2K9zQG-GkC2wINaBw1sNzIR'),
		alt: 'Instructor working with the vehicle computing system',
		caption: 'Team 04',
	},
	{
		src: driveImage('1duJQZkXcQ0zsRRdIJ20Pe5PA1-Wqb0br'),
		alt: 'Vehicle computing lab research activity',
		caption: 'Team 05',
	},
];

const milestoneTwoPhotos = [
	{
		src: driveImage('10c5i7vPtG-Sb7IOf3I_A81nzQhquqCsx'),
		alt: 'Students preparing the robotic vehicle for campus data collection',
		caption: 'Preparing the vehicle for campus data collection',
	},
	{
		src: driveImage('1ZEuUnyxAV_PNs14knJ--0H4itwJ8KeRg'),
		alt: 'Students collecting synchronized sensor data on campus',
		caption: 'Collecting synchronized camera and LiDAR data',
	},
	{
		src: driveImage('1vJlJnc8M-FIaBFrlXoYKzaCWd5VIe1Kc'),
		alt: 'Students walking beside the robotic vehicle during a campus drive',
		caption: 'Conducting the outdoor campus drive',
	},
	{
		src: driveImage('1_fcCpk4ny0Si-F1UZVe6emi7Y5EWe6sS'),
		alt: 'Robotic vehicle collecting outdoor campus data',
		caption: 'Observing the vehicle during data collection',
	},
];
---

<section class="milestone section-shell" id="milestone-1">
	<div class="milestone-timeline-marker" aria-hidden="true">
		<span>Milestone 01</span>
	</div>

	<div class="section-heading-row">
		<div>
			<p class="section-kicker">Milestone 01</p>

			<h2>
				Hands-On Urban Autonomy: Designing and Testing Challenging
				CARLA Scenarios
			</h2>

			<p>
				Students strengthen their hands-on simulation, teamwork,
				observation, and communication skills while demonstrating
				vehicle behavior and unexpected results.
			</p>
		</div>
	</div>

	<div class="milestone-gallery">
		{
			milestonePhotos.map((photo, index) => (
				<figure
					class:list={[
						'milestone-photo',
						{ 'milestone-photo-featured': index === 0 },
					]}
				>
					<img
						src={photo.src}
						alt={photo.alt}
						loading={index === 0 ? 'eager' : 'lazy'}
						referrerpolicy="no-referrer"
					/>

					<figcaption>
						<span>
							{String(index + 1).padStart(2, '0')}
						</span>

						{photo.caption}
					</figcaption>
				</figure>
			))
		}
	</div>
</section>

<section
	class="milestone-two section-shell"
	id="milestone-2"
	data-milestone-two
>
	<div class="milestone-timeline-marker" aria-hidden="true">
		<span>Milestone 02</span>
	</div>

	<div class="milestone-two-heading">
		<p class="section-kicker">Milestone 02</p>

		<h2>Turn a Campus Drive into Digital Data</h2>

		<p>
			Students collect synchronized camera and LiDAR data during a campus
			drive and transform real-world observations into structured digital
			data for perception, analysis, and autonomous-vehicle research.
		</p>
	</div>

	<div class="milestone-two-content">
		<div
			class="milestone-two-carousel"
			aria-label="Milestone 2 campus-drive photographs"
			tabindex="0"
		>
			<div class="milestone-two-slides" aria-live="polite">
				{
					milestoneTwoPhotos.map((photo, index) => (
						<figure
							class:list={[
								'milestone-two-slide',
								{ 'is-active': index === 0 },
							]}
							data-slide
							aria-hidden={index === 0 ? 'false' : 'true'}
						>
							<img
								src={photo.src}
								alt={photo.alt}
								loading={index === 0 ? 'eager' : 'lazy'}
								referrerpolicy="no-referrer"
							/>

							<figcaption>{photo.caption}</figcaption>
						</figure>
					))
				}

				<button
					class="milestone-two-arrow milestone-two-arrow-left"
					type="button"
					data-previous-slide
					aria-label="Show previous photograph"
				>
					<span aria-hidden="true">←</span>
				</button>

				<button
					class="milestone-two-arrow milestone-two-arrow-right"
					type="button"
					data-next-slide
					aria-label="Show next photograph"
				>
					<span aria-hidden="true">→</span>
				</button>

				<div
					class="milestone-two-counter"
					aria-hidden="true"
				>
					<span data-current-slide>01</span>
					<span>/</span>

					<span>
						{String(milestoneTwoPhotos.length).padStart(2, '0')}
					</span>
				</div>
			</div>

			<div
				class="milestone-two-dots"
				aria-label="Select a photograph"
			>
				{
					milestoneTwoPhotos.map((photo, index) => (
						<button
							class:list={[
								'milestone-two-dot',
								{ 'is-active': index === 0 },
							]}
							type="button"
							data-slide-dot
							data-slide-index={index}
							aria-label={`Show photograph ${index + 1}: ${photo.caption}`}
							aria-current={index === 0 ? 'true' : 'false'}
						/>
					))
				}
			</div>
		</div>

		<figure class="milestone-two-video">
			<div class="milestone-two-video-frame">
				<div class="milestone-two-coming-soon">
					<span>Video Demonstration</span>

					<strong>Coming Soon</strong>

					<p>
						Campus drive and synchronized sensor-data collection
					</p>
				</div>
			</div>

			<figcaption>
				Campus drive and synchronized sensor-data collection
			</figcaption>
		</figure>
	</div>
</section>

<script>
	function initializeMilestoneTwoCarousel() {
		const carousels = document.querySelectorAll(
			'[data-milestone-two]:not([data-carousel-ready])'
		);

		carousels.forEach((section) => {
			section.setAttribute('data-carousel-ready', 'true');

			const carousel = section.querySelector(
				'.milestone-two-carousel'
			);

			const slides = Array.from(
				section.querySelectorAll('[data-slide]')
			);

			const dots = Array.from(
				section.querySelectorAll('[data-slide-dot]')
			);

			const previousButton = section.querySelector(
				'[data-previous-slide]'
			);

			const nextButton = section.querySelector(
				'[data-next-slide]'
			);

			const currentSlideLabel = section.querySelector(
				'[data-current-slide]'
			);

			const slideContainer = section.querySelector(
				'.milestone-two-slides'
			);

			if (!carousel || slides.length === 0) return;

			let currentIndex = 0;
			let touchStartX = 0;
			let touchEndX = 0;

			function showSlide(newIndex) {
				currentIndex =
					(newIndex + slides.length) % slides.length;

				slides.forEach((slide, index) => {
					const isActive = index === currentIndex;

					slide.classList.toggle('is-active', isActive);

					slide.setAttribute(
						'aria-hidden',
						isActive ? 'false' : 'true'
					);
				});

				dots.forEach((dot, index) => {
					const isActive = index === currentIndex;

					dot.classList.toggle('is-active', isActive);

					dot.setAttribute(
						'aria-current',
						isActive ? 'true' : 'false'
					);
				});

				if (currentSlideLabel) {
					currentSlideLabel.textContent = String(
						currentIndex + 1
					).padStart(2, '0');
				}
			}

			previousButton?.addEventListener('click', () => {
				showSlide(currentIndex - 1);
			});

			nextButton?.addEventListener('click', () => {
				showSlide(currentIndex + 1);
			});

			dots.forEach((dot, index) => {
				dot.addEventListener('click', () => {
					showSlide(index);
				});
			});

			carousel.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					showSlide(currentIndex - 1);
				}

				if (event.key === 'ArrowRight') {
					event.preventDefault();
					showSlide(currentIndex + 1);
				}
			});

			slideContainer?.addEventListener(
				'touchstart',
				(event) => {
					touchStartX =
						event.changedTouches[0]?.screenX ?? 0;
				},
				{ passive: true }
			);

			slideContainer?.addEventListener(
				'touchend',
				(event) => {
					touchEndX =
						event.changedTouches[0]?.screenX ?? 0;

					const swipeDistance =
						touchEndX - touchStartX;

					if (Math.abs(swipeDistance) < 50) return;

					if (swipeDistance < 0) {
						showSlide(currentIndex + 1);
					} else {
						showSlide(currentIndex - 1);
					}
				},
				{ passive: true }
			);

			showSlide(0);
		});
	}

	initializeMilestoneTwoCarousel();

	document.addEventListener(
		'astro:page-load',
		initializeMilestoneTwoCarousel
	);
</script>

<style>
	/* Shared timeline */

	.milestone,
	.milestone-two {
		position: relative;
		overflow: visible;
		border-left: 3px solid #d4d4d4;
		padding-left: clamp(3.5rem, 6vw, 7rem);
	}

	.milestone-timeline-marker {
		position: absolute;
		z-index: 10;
		top: clamp(3.5rem, 6vw, 6rem);
		left: -1.5px;
		width: clamp(0.9rem, 1.2vw, 1.15rem);
		aspect-ratio: 1;
		border: 3px solid #fff;
		border-radius: 50%;
		background: #bfc2c5;
		box-shadow: 0 0 0 1px #d4d4d4;
		transform: translate(-50%, -50%);
	}

	.milestone-timeline-marker span {
		position: absolute;
		top: 50%;
		right: clamp(1.25rem, 2vw, 2rem);
		color: #737373;
		font-size: clamp(0.8rem, 1vw, 1rem);
		font-weight: 500;
		letter-spacing: 0.04em;
		white-space: nowrap;
		transform: translateY(-50%);
	}

	/* Reduced space between milestones */

	#milestone-1 {
		margin-bottom: 0 !important;
		padding-bottom: clamp(0.5rem, 1vw, 1rem) !important;
	}

	#milestone-2 {
		margin-top: 0 !important;
		padding-top: clamp(0.5rem, 1vw, 1rem) !important;
		padding-bottom: clamp(4rem, 7vw, 8rem);
	}

	/* Milestone 1 hover pop-up */

	.milestone-gallery {
		position: relative;
		overflow: visible;
		isolation: isolate;
	}

	.milestone-photo {
		position: relative;
		z-index: 1;
		overflow: hidden;
		transform: scale(1);
		transform-origin: center;
		transition:
			transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 450ms ease;
	}

	.milestone-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 450ms ease;
	}

	.milestone-photo:hover,
	.milestone-photo:focus-within {
		z-index: 1000;
		transform: scale(2);
		box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.4);
	}

	.milestone-photo:hover img,
	.milestone-photo:focus-within img {
		transform: scale(1.05);
	}

	/* Milestone 2 heading */

	.milestone-two-heading {
		max-width: 76rem;
		margin-bottom: clamp(2rem, 4vw, 4.5rem);
	}

	.milestone-two-heading h2 {
		max-width: none;
		margin: 0 0 1.25rem;
		font-size: clamp(2rem, 3.4vw, 4.25rem);
		line-height: 0.98;
		letter-spacing: -0.045em;
		white-space: nowrap;
	}

	.milestone-two-heading > p:last-child {
		max-width: 75ch;
		margin: 0;
		font-size: clamp(1rem, 1.15vw, 1.25rem);
		line-height: 1.7;
	}

	/* Milestone 2 layout */

	.milestone-two-content {
		position: relative;
		display: grid;
		overflow: visible;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.25rem, 2.5vw, 3rem);
		align-items: stretch;
		isolation: isolate;
	}

	.milestone-two-carousel,
	.milestone-two-video {
		min-width: 0;
		margin: 0;
	}

	/* Milestone 2 carousel pop-up */

	.milestone-two-carousel {
		position: relative;
		z-index: 1;
		transform: scale(1);
		transform-origin: left center;
		transition:
			transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
			filter 450ms ease;
	}

	.milestone-two-carousel:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 6px;
	}

	.milestone-two-slides {
		position: relative;
		overflow: hidden;
		height: clamp(18rem, 27vw, 30rem);
		border-radius: clamp(1rem, 1.5vw, 1.75rem);
		background: #121212;
	}

	.milestone-two-slide {
		position: absolute;
		inset: 0;
		overflow: hidden;
		margin: 0;
		visibility: hidden;
		opacity: 0;
		transform: scale(1.02);
		transition:
			opacity 450ms ease,
			transform 650ms ease,
			visibility 450ms ease;
	}

	.milestone-two-slide.is-active {
		visibility: visible;
		opacity: 1;
		transform: scale(1);
	}

	.milestone-two-slide img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 500ms ease;
	}

	.milestone-two-slide figcaption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		padding:
			clamp(3.5rem, 8vw, 7rem)
			clamp(1.25rem, 3vw, 2.5rem)
			clamp(1.25rem, 2vw, 2rem);
		color: #fff;
		font-size: clamp(0.9rem, 1vw, 1.1rem);
		background: linear-gradient(
			to top,
			rgba(0, 0, 0, 0.85),
			transparent
		);
	}

	/* Carousel buttons */

	.milestone-two-arrow {
		position: absolute;
		z-index: 20;
		top: 50%;
		display: grid;
		width: clamp(2.75rem, 4vw, 4rem);
		aspect-ratio: 1;
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.45);
		border-radius: 50%;
		color: #fff;
		background: rgba(0, 0, 0, 0.55);
		cursor: pointer;
		place-items: center;
		transform: translateY(-50%);
		transition:
			background-color 180ms ease,
			transform 180ms ease;
		backdrop-filter: blur(8px);
	}

	.milestone-two-arrow:hover {
		background: rgba(0, 0, 0, 0.85);
		transform: translateY(-50%) scale(1.08);
	}

	.milestone-two-arrow:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
	}

	.milestone-two-arrow-left {
		left: clamp(0.75rem, 1.5vw, 1.5rem);
	}

	.milestone-two-arrow-right {
		right: clamp(0.75rem, 1.5vw, 1.5rem);
	}

	.milestone-two-counter {
		position: absolute;
		z-index: 20;
		top: clamp(0.75rem, 1.5vw, 1.5rem);
		right: clamp(0.75rem, 1.5vw, 1.5rem);
		padding: 0.55rem 0.85rem;
		border: 1px solid rgba(255, 255, 255, 0.35);
		border-radius: 999px;
		color: #fff;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		background: rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(8px);
	}

	.milestone-two-dots {
		display: flex;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.milestone-two-dot {
		width: 0.7rem;
		height: 0.7rem;
		padding: 0;
		border: 1px solid currentColor;
		border-radius: 50%;
		background: transparent;
		cursor: pointer;
		opacity: 0.55;
		transition:
			width 180ms ease,
			border-radius 180ms ease,
			background-color 180ms ease,
			opacity 180ms ease;
	}

	.milestone-two-dot.is-active {
		width: 2rem;
		border-radius: 999px;
		background: currentColor;
		opacity: 1;
	}

	/* Coming Soon video box */

	.milestone-two-video {
		display: flex;
		flex-direction: column;
	}

	.milestone-two-video-frame {
		position: relative;
		display: grid;
		height: clamp(18rem, 27vw, 30rem);
		overflow: hidden;
		border-radius: clamp(1rem, 1.5vw, 1.75rem);
		background:
			radial-gradient(
				circle at 20% 20%,
				rgba(35, 189, 180, 0.55),
				transparent 40%
			),
			linear-gradient(
				135deg,
				#052d43 0%,
				#0b6170 55%,
				#07968f 100%
			);
		place-items: center;
	}

	.milestone-two-coming-soon {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 2rem;
		color: #fff;
		text-align: center;
	}

	.milestone-two-coming-soon span {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.7;
	}

	.milestone-two-coming-soon strong {
		font-size: clamp(2.5rem, 4vw, 4.5rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.milestone-two-coming-soon p {
		max-width: 32ch;
		margin: 0;
		font-size: clamp(0.9rem, 1vw, 1.05rem);
		line-height: 1.5;
		opacity: 0.75;
	}

	.milestone-two-video figcaption {
		margin-top: 1rem;
		font-size: clamp(0.9rem, 1vw, 1.05rem);
		line-height: 1.5;
	}

	/* Tablet */

	@media (max-width: 900px) {
		.milestone-two-heading h2 {
			white-space: normal;
		}

		.milestone-two-content {
			grid-template-columns: 1fr;
		}

		.milestone-two-slides,
		.milestone-two-video-frame {
			height: auto;
			min-height: auto;
			aspect-ratio: 16 / 10;
		}

	}

	/* Mobile */

	@media (max-width: 540px) {
		.milestone,
		.milestone-two {
			padding-left: 2.25rem;
		}

		.milestone-timeline-marker span {
			display: none;
		}

		#milestone-1 {
			padding-bottom: 0.5rem !important;
		}

		#milestone-2 {
			padding-top: 0.5rem !important;
			padding-bottom: 3.5rem;
		}

		.milestone-two-heading h2 {
			font-size: clamp(2rem, 11vw, 3.25rem);
		}

		.milestone-two-slides {
			aspect-ratio: 4 / 5;
		}

		.milestone-two-video-frame {
			aspect-ratio: 16 / 9;
		}

		.milestone-two-arrow {
			width: 2.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.milestone-photo,
		.milestone-photo img,
		.milestone-two-carousel,
		.milestone-two-slide,
		.milestone-two-slide img,
		.milestone-two-arrow,
		.milestone-two-dot {
			transition: none;
		}
	}
</style>