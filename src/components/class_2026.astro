---
import MilestoneThree from './MilestoneThree.astro';
import MilestoneFour from './MilestoneFour.astro';

const driveImage = (fileId) =>
  `https://drive.google.com/thumbnail?id=${fileId}&sz=w1600`;

const milestonePhotos = [
    {
    src: driveImage('1n2xz9FJ154pdeU-Lt7iw3xk5UujvN8P7'),
    alt: 'Robot vehicle prepared for a research milestone',
    caption: 'Team 01',
  },
  {
    src: driveImage('1sRknQDcbOrGfV-_AeYFp0hRkK9gid1EF'),
    alt: 'Autonomous research vehicle',
    caption: 'Team 02',
  },
  {
    src: driveImage('16mSPEcpeoReLfRCrOz8_FuCJd4GxP-jy'),
    alt: 'Outdoor vehicle computing testbed',
    caption: 'Team 03',
  },
  {
    src: driveImage('17ZwRj6Cij2K9zQG-GkC2wINaBw1sNzIR'),
    alt: 'Instructor working with the vehicle computing system',
    caption: 'Team 04',
  },
  {
    src: driveImage('1duJQZkXcQ0zsRRdIJ20Pe5PA1-Wqb0br'),
    alt: 'Vehicle computing lab research activity',
    caption: 'Team 05',
  },
];

const milestoneTwoPhotos = [
  {
    src: driveImage('10c5i7vPtG-Sb7IOf3I_A81nzQhquqCsx'),
    alt: 'Students preparing the robotic vehicle for campus data collection',
    caption: 'Preparing the vehicle for campus data collection',
  },
  {
    src: `${import.meta.env.BASE_URL}/images/learning-build.jpg`,
    alt: 'Students collecting synchronized sensor data on campus',
    caption: 'Collecting synchronized camera and LiDAR data',
  },
  {
    src: driveImage('1vJlJnc8M-FIaBFrlXoYKzaCWd5VIe1Kc'),
    alt: 'Students walking beside the robotic vehicle during a campus drive',
    caption: 'Conducting the outdoor campus drive',
  },
  {
    src: driveImage('1_fcCpk4ny0Si-F1UZVe6emi7Y5EWe6sS'),
    alt: 'Robotic vehicle collecting outdoor campus data',
    caption: 'Observing the vehicle during data collection',
  },
  {
    src: `${import.meta.env.BASE_URL}/images/campus-drive-5.jpg`,
    alt: 'A student team with the robotic vehicle outside the Vehicle Computing Lab',
    caption: 'Getting ready outside the Vehicle Computing Lab',
  },
  {
    src: `${import.meta.env.BASE_URL}/images/campus-drive-6.jpg`,
    alt: 'Students teleoperating the robotic vehicle on a campus walkway',
    caption: 'Teleoperating the vehicle along the campus route',
  },
];
---

<div class="milestones-intro section-shell">
  <h2>Five Course Milestones</h2>
</div>

<section class="milestone section-shell" id="milestone-1">
  <div class="milestone-timeline-marker" aria-hidden="true">
    <span>Milestone 01</span>
  </div>

  <div class="section-heading-row">
    <div>
      <p class="section-kicker">Milestone 01</p>

      <h2>Design of a Smart City Scenario in CARLA Simulator</h2>

      <p>
        Students use a preconfigured CARLA simulator to create or modify a
        city scenario by setting routes, traffic, vehicles, pedestrians,
        obstacles, roadside conditions, and weather. Teams may introduce
        challenging situations such as congestion, blocked routes,
        near-conflicts, or simulated collisions to observe
        autonomous-vehicle responses.
      </p>
    </div>
  </div>

  <div class="milestone-gallery">
    {
      milestonePhotos.map((photo, index) => (
        <figure
          class:list={[
            'milestone-photo',
            { 'milestone-photo-featured': index === 0 },
          ]}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            referrerpolicy="no-referrer"
          />

          <figcaption>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {photo.caption}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <p class="milestone-outcome">
    <strong>Outcome:</strong> Each team presents its customized
    smart-city simulation, showing the scenario, vehicle behavior,
    initial prediction, and observed results.
  </p>
</section>

<section
  class="milestone-two section-shell"
  id="milestone-2"
  data-milestone-two
>
  <div class="milestone-timeline-marker" aria-hidden="true">
    <span>Milestone 02</span>
  </div>

  <div class="milestone-two-heading">
    <p class="section-kicker">Milestone 02</p>

    <h2>From a Campus Drive to Robot Vision</h2>

    <p class="milestone-two-text">
      What does the world look like through a robot's cameras and 3D LiDAR sensors?
      Students take turns teleoperating a large robotic vehicle across campus,
      exploring how its sensors capture the surrounding environment through 2D
      camera images and 3D LiDAR point clouds. Back in the lab, students examine
      what robot sensor data looks like and use real-world driving images from
      the KITTI dataset to experiment with YOLO object detection. They investigate
      how AI identifies vehicles and pedestrians, how different training choices
      affect detection results, and why objects are sometimes missed or
      incorrectly recognized.
    </p>
  </div>

  <div class="milestone-two-content">
    <div
      class="milestone-two-carousel"
      aria-label="Milestone 2 campus-drive photographs"
      tabindex="0"
    >
      <div class="milestone-two-slides" aria-live="polite">
        {
          milestoneTwoPhotos.map((photo, index) => (
            <figure
              class:list={[
                'milestone-two-slide',
                { 'is-active': index === 0 },
              ]}
              data-slide
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <img
                src={photo.src}
                alt={photo.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
                referrerpolicy="no-referrer"
              />

              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))
        }

        <button
          class="milestone-two-arrow milestone-two-arrow-left"
          type="button"
          data-previous-slide
          aria-label="Show previous photograph"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
        </button>

        <button
          class="milestone-two-arrow milestone-two-arrow-right"
          type="button"
          data-next-slide
          aria-label="Show next photograph"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
        </button>
      </div>

      <div class="milestone-two-navigation">
        <div
          class="milestone-two-dots"
          aria-label="Select a photograph"
        >
          {
            milestoneTwoPhotos.map((photo, index) => (
              <button
                class:list={[
                  'milestone-two-dot',
                  { 'is-active': index === 0 },
                ]}
                type="button"
                data-slide-dot
                data-slide-index={index}
                aria-label={`Show photograph ${index + 1}: ${photo.caption}`}
                aria-current={index === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>
        <div class="milestone-two-counter" aria-hidden="true">
          <span data-current-slide>1</span>
          <span>/</span>
          <span>{milestoneTwoPhotos.length}</span>
        </div>
      </div>
    </div>

    <figure class="milestone-two-video">
      <div class="milestone-two-video-frame">
        <video
          src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/videos/campus-drive.mp4`}
          aria-label="Milestone 2: Campus Drive and Sensor Data Collection"
          controls
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          data-campus-drive
        >
          Your browser does not support embedded video.
          <a href="https://drive.google.com/file/d/1S10IDUOWnerAN7MmIfmedAsMff_tGXDO/view">Open the video</a>.
        </video>
      </div>

      <figcaption>
        Campus drive and synchronized sensor-data collection
      </figcaption>
    </figure>
  </div>

  <p class="milestone-two-outcome">
    <strong>Outcome:</strong> Students learn to explore the world from a robot's
    perspective and use sensor data to investigate how well AI can understand
    its surroundings. Each team presents a YOLO-based A/B demonstration, using
    evidence to explain differences in detection performance, unexpected
    results, and areas for improvement.
  </p>
</section>

<MilestoneThree />
<MilestoneFour />

<div class="milestones-upcoming section-shell">
  <span class="milestones-upcoming-dot" aria-hidden="true"></span>
  <p class="section-kicker">Milestone 05</p>
  <p class="milestones-upcoming-text">Coming soon — the final milestone is in progress this semester.</p>
</div>

<script>
  function initializeMilestoneTwoCarousel() {
    const carousels = document.querySelectorAll(
      '[data-milestone-two]:not([data-carousel-ready])'
    );

    carousels.forEach((section) => {
      section.setAttribute('data-carousel-ready', 'true');

      const carousel = section.querySelector<HTMLElement>(
        '.milestone-two-carousel'
      );

      const slides = Array.from(
        section.querySelectorAll<HTMLElement>('[data-slide]')
      );

      const dots = Array.from(
        section.querySelectorAll<HTMLButtonElement>('[data-slide-dot]')
      );

      const previousButton = section.querySelector(
        '[data-previous-slide]'
      );

      const nextButton = section.querySelector(
        '[data-next-slide]'
      );

      const currentSlideLabel = section.querySelector(
        '[data-current-slide]'
      );

      const slideContainer = section.querySelector<HTMLElement>(
        '.milestone-two-slides'
      );

      if (!carousel || slides.length === 0) return;

      let currentIndex = 0;
      let touchStartX = 0;
      let touchEndX = 0;

      function showSlide(newIndex: number) {
        currentIndex =
          (newIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === currentIndex;

          slide.classList.toggle('is-active', isActive);
          slide.setAttribute(
            'aria-hidden',
            isActive ? 'false' : 'true'
          );
        });

        dots.forEach((dot, index) => {
          const isActive = index === currentIndex;

          dot.classList.toggle('is-active', isActive);
          dot.setAttribute(
            'aria-current',
            isActive ? 'true' : 'false'
          );
        });

        if (currentSlideLabel) {
          currentSlideLabel.textContent =
            String(currentIndex + 1);
        }
      }

      previousButton?.addEventListener('click', () => {
        showSlide(currentIndex - 1);
      });

      nextButton?.addEventListener('click', () => {
        showSlide(currentIndex + 1);
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          showSlide(index);
        });
      });

      carousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showSlide(currentIndex - 1);
        }

        if (event.key === 'ArrowRight') {
          event.preventDefault();
          showSlide(currentIndex + 1);
        }
      });

      slideContainer?.addEventListener(
        'touchstart',
        (event) => {
          touchStartX = event.changedTouches[0]?.screenX ?? 0;
        },
        { passive: true }
      );

      slideContainer?.addEventListener(
        'touchend',
        (event) => {
          touchEndX = event.changedTouches[0]?.screenX ?? 0;

          const swipeDistance = touchEndX - touchStartX;

          if (Math.abs(swipeDistance) < 50) return;

          if (swipeDistance < 0) {
            showSlide(currentIndex + 1);
          } else {
            showSlide(currentIndex - 1);
          }
        },
        { passive: true }
      );

      showSlide(0);
    });
  }

  function initializeMilestoneTwoVideo() {
    const videos = document.querySelectorAll<HTMLVideoElement>(
      '#milestone-2 video[data-campus-drive]:not([data-video-ready])'
    );

    videos.forEach((video) => {
      video.dataset.videoReady = 'true';
      video.muted = true;

      const setInitialSpeed = () => {
        video.defaultPlaybackRate = 1.5;
        video.playbackRate = 1.5;
      };

      setInitialSpeed();
      if (video.readyState === HTMLMediaElement.HAVE_NOTHING) {
        video.addEventListener('loadedmetadata', setInitialSpeed, { once: true });
      }

      // Make one attempt; respect the viewer's pause and seek actions afterward.
      void video.play().catch(() => {});
    });
  }

  initializeMilestoneTwoCarousel();
  initializeMilestoneTwoVideo();

  document.addEventListener(
    'astro:page-load',
    initializeMilestoneTwoCarousel
  );
  document.addEventListener('astro:page-load', initializeMilestoneTwoVideo);
</script>

<style>
  /* Milestones intro heading */

  .milestones-intro {
    border-left: 3px solid #d4d4d4;
    padding: clamp(4rem, 6vw, 5.5rem) 0 0 clamp(3.5rem, 6vw, 7rem);
  }

  /* Intro heading and the Milestone 01 title swap styles */
  .milestones-intro h2 {
    margin: 0;
    color: var(--wm-green-dark);
    font-size: clamp(2.3rem, 3.6vw, 3.6rem);
    line-height: 1.04;
  }

  #milestone-1 .section-heading-row h2 + p {
    max-width: 52rem;
    margin: 14px 0 0;
    line-height: 1.6;
  }

  #milestone-1 .section-heading-row {
    margin-bottom: 20px;
  }

  #milestone-1 .milestone-outcome {
    max-width: 52rem;
    margin: 22px 0 0;
    padding-left: 14px;
    border-left: 3px solid var(--wm-gold);
    line-height: 1.6;
  }

  #milestone-1 .milestone-outcome strong {
    color: #00241b;
  }

  #milestone-1 .section-kicker,
  #milestone-2 .section-kicker {
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
  }

  #milestone-2 .milestone-timeline-marker {
    top: calc(clamp(0.5rem, 1vw, 1rem) + 0.7rem);
  }

  #milestone-2 .milestone-two-heading .section-kicker {
    margin-bottom: 14px;
  }

  #milestone-2 .milestone-two-heading h2 {
    margin-bottom: 14px;
  }

  #milestone-1 .section-heading-row h2,
  #milestone-2 .milestone-two-heading h2 {
    color: var(--wm-green-dark);
    font-size: clamp(1.85rem, 2.7vw, 2.5rem);
    line-height: 1.08;
  }

  @media (max-width: 600px) {
    .milestones-intro h2 {
      font-size: clamp(2rem, 9vw, 3rem);
      line-height: 1.02;
    }
  }

  /* Shared timeline */

  .milestone,
  .milestone-two {
    position: relative;
    overflow: visible;
    border-left: 3px solid #d4d4d4;
    padding-left: clamp(3.5rem, 6vw, 7rem);
  }

  .milestone-timeline-marker {
    position: absolute;
    z-index: 10;
    top: clamp(3.5rem, 6vw, 6rem);
    left: -1.5px;
    width: clamp(0.9rem, 1.2vw, 1.15rem);
    aspect-ratio: 1;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #bfc2c5;
    box-shadow: 0 0 0 1px #d4d4d4;
    transform: translate(-50%, -50%);
  }

  .milestone-timeline-marker span {
    position: absolute;
    top: 50%;
    right: clamp(1.25rem, 2vw, 2rem);
    color: #737373;
    font-size: clamp(0.8rem, 1vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transform: translateY(-50%);
  }

  #milestone-1 {
    margin-bottom: 0 !important;
    padding-top: clamp(2.5rem, 4vw, 3.5rem) !important;
    padding-bottom: clamp(2.25rem, 3.5vw, 3rem) !important;
  }

  #milestone-1 .milestone-timeline-marker {
    top: calc(clamp(2.5rem, 4vw, 3.5rem) + 0.45rem);
  }

  #milestone-2 {
    margin-top: 0 !important;
    padding-top: clamp(0.5rem, 1vw, 1rem) !important;
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  /* Upcoming milestones placeholder */

  .milestones-upcoming {
    position: relative;
    border-left: 3px dashed #d4d4d4;
    padding: 0 0 clamp(4rem, 7vw, 6rem) clamp(3.5rem, 6vw, 7rem);
  }

  .milestones-upcoming-dot {
    position: absolute;
    top: 0.45rem;
    left: -1.5px;
    width: clamp(0.9rem, 1.2vw, 1.15rem);
    aspect-ratio: 1;
    border: 2px solid #bfc2c5;
    border-radius: 50%;
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .milestones-upcoming .section-kicker {
    margin: 0 0 8px;
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
  }

  .milestones-upcoming-text {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    font-style: italic;
  }

  /* Milestone 1 */

  .milestone-gallery {
    position: relative;
    overflow: visible;
    isolation: isolate;
  }

  .milestone-photo {
    position: relative;
    z-index: 1;
    overflow: hidden;
    transform: scale(1);
    transform-origin: center;
    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 450ms ease;
  }

  .milestone-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .milestone-photo:hover,
  .milestone-photo:focus-within {
    z-index: 1000;
    transform: scale(2);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.4);
  }

  .milestone-photo:hover img,
  .milestone-photo:focus-within img {
    transform: scale(1.05);
  }

  /* Milestone 2 heading */

  .milestone-two-heading {
    max-width: 76rem;
    margin-bottom: 20px;
  }

  .milestone-two-heading h2 {
    max-width: none;
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 3.4vw, 4.25rem);
    line-height: 1.04;
    white-space: nowrap;
  }

  .milestone-two-heading > .milestone-two-text {
    max-width: none;
    margin: 0;
    font-size: clamp(1rem, 1.15vw, 1.25rem);
    line-height: 1.7;
  }

  .milestone-two-heading > .milestone-two-text + .milestone-two-text {
    margin-top: 0.9em;
  }

  .milestone-two-outcome {
    margin: 12px 0 0;
    padding-left: 14px;
    border-left: 3px solid var(--wm-gold);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
  }

  .milestone-two-outcome strong {
    color: var(--wm-green-dark);
  }

  /* Shared image and video dimensions */

  .milestone-two-content {
    position: relative;
    display: grid;
    overflow: visible;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 3rem);
    align-items: start;
    isolation: isolate;
  }

  .milestone-two-carousel,
  .milestone-two-video {
    min-width: 0;
    margin: 0;
  }

  .milestone-two-slides,
  .milestone-two-video-frame {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    max-height: 18rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: #121212;
  }

  /* Carousel */

  .milestone-two-carousel {
    position: relative;
    z-index: 1;
    transform: scale(1);
    transform-origin: left center;
    transition:
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 450ms ease;
  }

  .milestone-two-carousel:focus-visible {
    outline: 2px solid #62645d;
    outline-offset: 6px;
  }

  .milestone-two-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    margin: 0;
    visibility: hidden;
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 450ms ease,
      transform 650ms ease,
      visibility 450ms ease;
  }

  .milestone-two-slide.is-active {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
  }

  .milestone-two-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .milestone-two-slide figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding:
      clamp(3.5rem, 8vw, 7rem)
      clamp(1.25rem, 3vw, 2.5rem)
      clamp(1.25rem, 2vw, 2rem);
    color: #fff;
    font-size: clamp(0.9rem, 1vw, 1.1rem);
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85),
      transparent
    );
  }

  .milestone-two-arrow {
    position: absolute;
    z-index: 20;
    top: 50%;
    display: grid;
    width: 44px;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 2px;
    color: #fff;
    background: transparent;
    cursor: pointer;
    place-items: center;
    transform: translateY(-50%);
    opacity: 0.9;
    filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.95)) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.7));
    transition: opacity 160ms ease;
    touch-action: manipulation;
  }

  .milestone-two-arrow:focus-visible {
    outline: 2px solid white;
    outline-offset: -4px;
    box-shadow: inset 0 0 0 5px rgba(0, 0, 0, 0.65);
  }

  .milestone-two-arrow svg {
    width: 20px;
    height: 20px;
    stroke-width: 1.5;
  }

  .milestone-two-arrow-left {
    left: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .milestone-two-arrow-right {
    right: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .milestone-two-counter {
    display: flex;
    gap: 3px;
    color: #666861;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .milestone-two-navigation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    margin-top: 8px;
  }

  .milestone-two-dots {
    display: flex;
    justify-content: center;
    gap: 2px;
    min-width: 0;
  }

  .milestone-two-dot {
    position: relative;
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
  }

  .milestone-two-dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #8a8c83;
    transform: translate(-50%, -50%);
    transition: width 160ms ease, background-color 160ms ease;
  }

  .milestone-two-dot.is-active::before {
    width: 14px;
    background: #62645d;
  }

  @media (hover: hover) and (pointer: fine) {
    .milestone-two-arrow { opacity: 0; }

    .milestone-two-carousel:hover .milestone-two-arrow,
    .milestone-two-carousel:focus-within .milestone-two-arrow { opacity: 1; }
  }

  @media (any-pointer: coarse), (max-width: 900px) {
    .milestone-two-arrow { opacity: 0.9; }
  }

  /* Video */

  .milestone-two-video {
    display: flex;
    flex-direction: column;
  }

  .milestone-two-video-frame {
    display: block;
    flex-shrink: 0;
