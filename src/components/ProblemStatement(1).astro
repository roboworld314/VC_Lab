---
const bottlenecks = [
  { number: "01", title: "Stale decision inputs", text: "Queueing delays force decisions to rely on outdated sensor evidence, even when individual models are accurate." },
  { number: "02", title: "Low-value data overload", text: "Redundant and vibration-distorted streams saturate onboard pipelines and consume scarce compute." },
  { number: "03", title: "Delayed critical evidence", text: "The most informative observations can arrive too late to support a safe real-time decision." },
];
---

<section id="problem-statement" class="content-section" aria-labelledby="problem-title">
  <div class="section-container">
    <header class="section-header">
      <p class="section-kicker">The research challenge</p>
      <h2 id="problem-title">The sensor-to-decision bottleneck</h2>
      <p class="section-lede">
        Agentic robots combine high-rate multimodal sensing with learned perception and foundation-model reasoning. In deployment, however, failures often arise because decisions are not grounded in <strong>fresh, decision-time evidence</strong>.
      </p>
    </header>

    <div class="bottleneck-grid">
      {bottlenecks.map((item) => (
        <article class="bottleneck-card">
          <span>{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>

    <aside class="solution-bridge">
      <span>Our approach</span>
      <p><strong>SenseGuard</strong> treats robustness as a decision-time freshness objective. It combines adaptive filtering with model-centric data curation so robots act on timely, informative evidence rather than stale inputs.</p>
    </aside>

    <div class="question-header">
      <p class="section-kicker">Research questions</p>
      <h3>Two connected objectives</h3>
    </div>
    <div class="question-grid">
      <article><span>RQ1 · Online autonomy</span><p>How can we maximize decision-time data freshness so onboard models remain effective under limited compute?</p></article>
      <article><span>RQ2 · Offline improvement</span><p>What minimal yet sufficient multimodal data should be retained to accelerate model improvement and robustness?</p></article>
    </div>
  </div>
</section>

<style>
  .content-section { padding: clamp(4rem, 8vw, 7rem) 1.5rem; }
  .section-container { width: min(1100px, 100%); margin: 0 auto; }
  .section-header { display: grid; grid-template-columns: 0.8fr 1.2fr; column-gap: 4rem; }
  .section-kicker { margin: 0 0 1rem; color: #0f716b; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  h2 { grid-column: 1; margin: 0; color: #152942; font-family: var(--font-heading, Georgia, serif); font-size: clamp(2.4rem, 4.8vw, 4.5rem); font-weight: 400; line-height: 1; letter-spacing: -0.045em; }
  .section-lede { grid-column: 2; grid-row: 1 / span 2; align-self: end; margin: 0; color: #5f707c; font-size: 1.08rem; line-height: 1.8; }
  .section-lede strong, .solution-bridge strong { color: #c05e3c; }
  .bottleneck-grid { margin-top: 3.5rem; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #d9dfdf; border-bottom: 1px solid #d9dfdf; }
  .bottleneck-card { padding: 2rem; border-right: 1px solid #d9dfdf; }
  .bottleneck-card:last-child { border-right: 0; }
  .bottleneck-card > span { color: #c05e3c; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; }
  .bottleneck-card h3 { margin: 1.6rem 0 0.7rem; color: #152942; font-size: 1.15rem; }
  .bottleneck-card p { margin: 0; color: #637480; font-size: 0.92rem; line-height: 1.7; }
  .solution-bridge { margin-top: 2rem; padding: 1.5rem 1.7rem; display: grid; grid-template-columns: 160px 1fr; gap: 1rem; border-radius: 14px; color: #fff; background: #152942; }
  .solution-bridge > span { color: #c8ee57; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .solution-bridge p { margin: 0; color: #d4dee4; line-height: 1.7; }
  .question-header { margin-top: 4.5rem; }
  .question-header h3 { margin: 0; color: #152942; font-size: 2rem; letter-spacing: -0.035em; }
  .question-grid { margin-top: 1.4rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .question-grid article { padding: 1.6rem; border-radius: 14px; border: 1px solid #dce2e2; background: #fff; }
  .question-grid span { color: #0f716b; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .question-grid p { margin: 0.9rem 0 0; color: #4d5f6b; line-height: 1.7; }
  @media (max-width: 760px) {
    .section-header { grid-template-columns: 1fr; }
    .section-lede { grid-column: 1; grid-row: auto; margin-top: 1.5rem; }
    .bottleneck-grid, .question-grid { grid-template-columns: 1fr; }
    .bottleneck-card { border-right: 0; border-bottom: 1px solid #d9dfdf; }
    .bottleneck-card:last-child { border-bottom: 0; }
    .solution-bridge { grid-template-columns: 1fr; }
  }
</style>
