---
const appendixUrl = "https://drive.google.com/file/d/1adc8mrF3CoUz2dJ_2IxYwd5p2cFx412H/view";
const demoUrl = "https://drive.google.com/file/d/1BV0f012GT49ySYrE-zComIcFRSKspdmL/preview";
---

<section id="hero" class="hero-section" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow"><span></span>Vehicle Computing Research</p>
      <h1 id="hero-title">SenseGuard</h1>
      <p class="hero-tagline">Sensor-to-decision adaptation for reliable agentic AI robots</p>
      <p class="hero-summary">
        Real-time adaptive perception and data selection under vibration and resource constraints.
      </p>

      <div class="hero-actions" aria-label="Project resources">
        <a href={appendixUrl} target="_blank" rel="noopener noreferrer" class="button button-primary">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12V8z"></path><path d="M14 2v6h6"></path></svg>
          Read appendix
        </a>
        <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="button button-secondary">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"></path></svg>
          Watch demo
        </a>
        <span class="resource-pending" title="Code will be published after the review period">Code · coming soon</span>
        <span class="resource-pending" title="Dataset will be published after the review period">Dataset · coming soon</span>
      </div>
    </div>

    <div class="hero-visual">
      <div class="visual-frame">
        <img
          src="https://lh3.googleusercontent.com/d/1Tc_J8SAASOFz-OovA0bAbX3_7NNMOSZW"
          alt="Autonomous research vehicle used to evaluate SenseGuard"
          width="900"
          height="600"
          loading="eager"
          decoding="async"
        />
        <div class="visual-overlay" aria-hidden="true"></div>
        <p class="visual-label"><span></span>Physical vehicle deployment</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: clamp(1rem, 3vw, 2rem);
  }

  .hero-inner {
    width: min(1180px, 100%);
    min-height: 570px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    overflow: hidden;
    border-radius: 26px;
    background: #152942;
    box-shadow: 0 24px 70px rgba(21, 41, 66, 0.16);
  }

  .hero-copy {
    padding: clamp(2.5rem, 6vw, 5.5rem);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    margin: 0 0 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #cbd8e2;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .eyebrow span,
  .visual-label span {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #c8ee57;
    box-shadow: 0 0 0 5px rgba(200, 238, 87, 0.14);
  }

  h1 {
    margin: 0;
    color: #c8ee57;
    font-family: var(--font-heading, Georgia, serif);
    font-size: clamp(3.8rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .hero-tagline {
    max-width: 640px;
    margin: 1.4rem 0 0;
    color: #fff;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .hero-summary {
    max-width: 570px;
    margin: 1.4rem 0 0;
    color: #b8c8d2;
    font-size: 1rem;
    line-height: 1.7;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .button {
    min-height: 44px;
    padding: 0 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
  }

  .button:hover { transform: translateY(-2px); }
  .button svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .button-primary { color: #152942; background: #c8ee57; }
  .button-secondary { color: #fff; border: 1px solid rgba(255, 255, 255, 0.3); }

  .resource-pending {
    padding: 0.45rem 0.2rem;
    color: #8fa4b1;
    font-size: 0.69rem;
  }

  .hero-visual { min-width: 0; padding: 1rem; }
  .visual-frame { height: 100%; min-height: 480px; position: relative; overflow: hidden; border-radius: 18px; background: #263d4a; }
  .visual-frame img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .visual-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 52%, rgba(8, 25, 37, 0.82)); }
  .visual-label { position: absolute; left: 1.4rem; bottom: 1.3rem; margin: 0; display: flex; align-items: center; gap: 0.7rem; color: #fff; font-size: 0.75rem; font-weight: 700; }

  @media (max-width: 850px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { min-height: 420px; }
    .visual-frame { min-height: 400px; }
  }

  @media (max-width: 560px) {
    .hero-section { padding: 0.75rem; }
    .hero-inner { border-radius: 18px; }
    .hero-copy { padding: 2.5rem 1.5rem; }
    h1 { font-size: 3.8rem; }
    .hero-visual { min-height: 330px; }
    .visual-frame { min-height: 310px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .button { transition: none; }
  }
</style>
