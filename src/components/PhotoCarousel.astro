---
import type { GalleryPhoto } from '../data/milestoneThreeGallery';

interface Props {
  id: string;
  label: string;
  photos: GalleryPhoto[];
  counterId?: string;
}

const { id, label, photos, counterId } = Astro.props;
const trackId = `${id}-slides`;
---

<div
  class="photo-carousel"
  data-photo-carousel
  data-photo-counter-id={counterId}
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  <div class="photo-carousel-track" id={trackId} data-photo-track>
    {photos.map((photo, index) => (
      <div
        class="photo-carousel-slide"
        data-photo-slide
        role="group"
        aria-roledescription="slide"
        aria-label={`Photograph ${index + 1} of ${photos.length}`}
        aria-hidden={index !== 0 ? 'true' : 'false'}
      >
        {photo.src ? (
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
            draggable="false"
            style={{ 'object-position': photo.position || 'center', 'object-fit': photo.fit || 'cover' }}
          />
        ) : (
          <div class="photo-placeholder" role="img" aria-label={photo.alt}>
            <svg viewBox="0 0 48 36" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="46" height="34" rx="3" />
              <circle cx="34" cy="10" r="3" />
              <path d="m2 28 12-13 12 13 7-7 13 12" />
            </svg>
            <p>
              <span class="placeholder-full">More photos coming soon</span>
              <span class="placeholder-short">More photos</span>
            </p>
          </div>
        )}
      </div>
    ))}
  </div>

  {photos.length > 1 && (
    <div class="photo-carousel-controls">
      <button
        class="photo-arrow photo-arrow-previous"
        type="button"
        data-photo-previous
        aria-label={`Previous photograph in ${label}`}
        aria-controls={trackId}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
      </button>
      <button
        class="photo-arrow photo-arrow-next"
        type="button"
        data-photo-next
        aria-label={`Next photograph in ${label}`}
        aria-controls={trackId}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
      </button>
    </div>
  )}

  <span class="photo-status" data-photo-status aria-live="polite" aria-atomic="true">
    {label}: Photograph 1 of {photos.length}
  </span>
</div>

<script>
  function initializePhotoCarousels() {
    document.querySelectorAll<HTMLElement>(
      '[data-photo-carousel]:not([data-carousel-ready])'
    ).forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-photo-track]');
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-photo-slide]'));
      const counter = document.getElementById(carousel.dataset.photoCounterId || '');
      const status = carousel.querySelector<HTMLElement>('[data-photo-status]');
      const label = carousel.getAttribute('aria-label') || 'Photographs';

      if (!track || slides.length === 0) return;

      let currentIndex = 0;
      let touchStart: { x: number; y: number } | null = null;

      function showSlide(index: number) {
        currentIndex = (index + slides.length) % slides.length;
        track!.style.setProperty('--photo-index', String(currentIndex));

        slides.forEach((slide, slideIndex) => {
          const active = slideIndex === currentIndex;
          slide.setAttribute('aria-hidden', String(!active));
          if (active) {
            const image = slide.querySelector('img');
            if (image) image.loading = 'eager';
          }
        });

        if (counter) counter.textContent = `${currentIndex + 1} / ${slides.length}`;
        if (status) status.textContent = `${label}: Photograph ${currentIndex + 1} of ${slides.length}`;
      }

      carousel.querySelector('[data-photo-previous]')?.addEventListener('click', () => {
        showSlide(currentIndex - 1);
      });
      carousel.querySelector('[data-photo-next]')?.addEventListener('click', () => {
        showSlide(currentIndex + 1);
      });

      carousel.addEventListener('keydown', (event) => {
        if (slides.length < 2 || event.altKey || event.ctrlKey || event.metaKey) return;
        const destinations: Record<string, number> = {
          ArrowLeft: currentIndex - 1,
          ArrowRight: currentIndex + 1,
          Home: 0,
          End: slides.length - 1,
        };
        if (!(event.key in destinations)) return;
        event.preventDefault();
        showSlide(destinations[event.key]);
      });

      track.addEventListener('touchstart', (event) => {
        const touch = event.touches[0];
        touchStart = event.touches.length === 1 && touch
          ? { x: touch.clientX, y: touch.clientY }
          : null;
      }, { passive: true });

      track.addEventListener('touchend', (event) => {
        const start = touchStart;
        touchStart = null;
        const touch = event.changedTouches[0];
        if (!start || !touch || event.touches.length > 0 || slides.length < 2) return;
        const dx = touch.clientX - start.x;
        const dy = touch.clientY - start.y;
        if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy) * 1.4) {
          showSlide(currentIndex + (dx < 0 ? 1 : -1));
        }
      }, { passive: true });

      track.addEventListener('touchcancel', () => { touchStart = null; }, { passive: true });
      carousel.setAttribute('data-carousel-ready', 'true');
    });
  }

  initializePhotoCarousels();
  document.addEventListener('astro:page-load', initializePhotoCarousels);
</script>

<style>
  .photo-carousel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    container-type: inline-size;
  }

  .photo-carousel-track {
    position: absolute;
    inset: 0;
    display: flex;
    transform: translateX(calc(var(--photo-index, 0) * -100%));
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
    touch-action: pan-y pinch-zoom;
  }

  .photo-carousel-slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 0;
    height: 100%;
  }

  .photo-carousel-slide img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 100%;
    padding: 32px 40px;
    color: var(--wm-green-dark);
    background: #e2e7de;
    text-align: center;
  }

  .photo-placeholder svg {
    flex: 0 0 auto;
    width: 36px;
    height: 27px;
    stroke-width: 1.4;
  }

  .photo-placeholder p {
    margin: 0;
    font-size: clamp(0.75rem, 1vw, 0.9375rem);
    line-height: 1.4;
  }

  .placeholder-short {
    display: none;
  }

  .photo-carousel-controls {
    display: none;
  }

  .photo-carousel[data-carousel-ready] .photo-carousel-controls {
    display: contents;
  }

  .photo-arrow {
    position: absolute;
    z-index: 1;
    top: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    color: white;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    transform: translateY(-50%);
    opacity: 0.9;
    filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.95)) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.7));
    transition: opacity 160ms ease;
  }

  .photo-arrow:focus-visible {
    outline: 2px solid white;
    outline-offset: -4px;
    box-shadow: inset 0 0 0 5px rgba(0, 0, 0, 0.65);
  }

  .photo-arrow-previous { left: 2px; }
  .photo-arrow-next { right: 2px; }

  .photo-arrow svg {
    width: 20px;
    height: 20px;
    stroke-width: 1.5;
  }

  .photo-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @container (max-width: 180px) {
    .photo-placeholder {
      gap: 0;
      padding: 0;
    }

    .photo-placeholder svg {
      width: 24px;
      height: 18px;
    }

    .photo-placeholder p {
      position: absolute;
      top: 6px;
      right: 4px;
      left: 4px;
      font-size: 0.6875rem;
      line-height: 1.2;
    }

    .placeholder-full { display: none; }
    .placeholder-short { display: inline; }

  }

  @media (hover: hover) and (pointer: fine) {
    .photo-arrow { opacity: 0; }

    .photo-carousel:hover .photo-arrow,
    .photo-carousel:focus-within .photo-arrow { opacity: 1; }
  }

  @media (any-pointer: coarse), (max-width: 900px) {
    .photo-arrow { opacity: 0.9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-carousel-track,
    .photo-arrow {
      transition: none;
    }
  }
</style>
