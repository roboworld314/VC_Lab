---
// Replace these placeholders with the confirmed guest-speaker details.
const guestSpeaker = {
  name: "Johora Akter Polin",
  position: "Graduate Researcher",
  institution: "William & Mary",
  talkTitle: "Guest Lecture Title",
  bio: "Johora Akter Polin is a Ph.D. student at William & Mary whose research focuses on edge intelligence and dependable connected and autonomous vehicles. Her recent work explores efficient edge AI, safety-aware vehicle control, and VLM-enhanced perception for reliable autonomous driving.",
  date: "September 18",
  time: "2:00 PM",
  location: "ISC4 1373",
  photo: `${import.meta.env.BASE_URL}images/guest-speaker-photo.png`,
  profileUrl: "#guest-speaker",
  talkUrl: "#experiments",
};
---

<section class="instructor section-shell" id="instructor">
  <div class="section-heading-row">
    <div>
      <p class="section-kicker">Course instructor</p>
      <h2>Meet the instructor.</h2>
    </div>
  </div>

  <article class="instructor-card">
    <div class="portrait-column">
      <div class="portrait-frame">
        <img
          src={`${import.meta.env.BASE_URL}images/instructor-photo.png`}
          alt="Professor Sidi Lu"
          width="450"
          height="450"
          loading="lazy"
        />
      </div>
      <span class="availability"><i aria-hidden="true"></i> Course instructor</span>
    </div>

    <div class="instructor-copy">
      <p class="role">Assistant Professor · Computer Science</p>
      <h3>Sidi Lu</h3>
      <p class="pronunciation">Pronounced <strong>“see-dee loo”</strong></p>
      <p class="bio">
        Dr. Lu’s research focuses on cyber-physical and intelligent systems, with particular interests in edge computing.<br />
        Her work develops reliable, scalable, secure, and efficient systems for connected vehicles and robots.<br />
        These technologies support other resource-constrained platforms in real-world environments.
      </p>

      <div class="research-tags" aria-label="Research interests">
        <span>Vehicle computing</span>
        <span>Edge intelligence</span>
        <span>Cyber-physical systems</span>
      </div>

      <dl class="instructor-details">
        <div><dt>Email</dt><dd><a href="mailto:sidi@wm.edu">sidi@wm.edu</a></dd></div>
        <div><dt>Office</dt><dd>ISC 1382</dd></div>
        <div><dt>Department</dt><dd>Computer Science, William &amp; Mary</dd></div>
      </dl>

      <div class="instructor-actions">
        <a class="profile-button" href="https://sidilu.org/" target="_blank" rel="noopener noreferrer">
          Visit instructor website
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
        <a class="university-link" href="https://cdsp.wm.edu/computerscience/people/lu-sidi.php" target="_blank" rel="noopener noreferrer">
          W&amp;M faculty profile
        </a>
      </div>
    </div>
  </article>

  <div class="guest-heading" id="guest-speaker">
    <p class="section-kicker">Guest lecture</p>
    <h2>Guest Lecturer Spotlight.</h2>
  </div>

  <article class="guest-card">
    <div class="guest-portrait">
      <img
        src={guestSpeaker.photo}
        alt={guestSpeaker.name}
        width="240"
        height="240"
        loading="lazy"
      />
      <span class="upcoming">Ph.D. Researcher</span>
    </div>

    <div class="guest-copy">
      <h3>{guestSpeaker.name}</h3>
      <p class="guest-affiliation">{guestSpeaker.position} · {guestSpeaker.institution}</p>
      <h4>{guestSpeaker.talkTitle}</h4>
      <p class="guest-bio">{guestSpeaker.bio}</p>
    </div>

    <aside class="guest-event" aria-label="Guest lecture details">
      <dl>
        <div><dt>Date</dt><dd>{guestSpeaker.date}</dd></div>
        <div><dt>Time</dt><dd>{guestSpeaker.time}</dd></div>
        <div><dt>Location</dt><dd>{guestSpeaker.location}</dd></div>
      </dl>

      <div class="guest-actions">
        <a class="profile-button" href={guestSpeaker.profileUrl}>
          Speaker profile
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>
        </a>
        <a class="guest-link" href={guestSpeaker.talkUrl}>Talk details</a>
      </div>
    </aside>
  </article>
</section>

<style>
  .instructor {
    width: min(1320px, calc(100% - 48px));
    padding: 120px 0;
  }

  .instructor-card {
    position: relative;
    display: grid;
    width: 100%;
    grid-template-columns: minmax(260px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    overflow: hidden;
    padding: clamp(18px, 2.5vw, 32px);
    border-radius: 28px;
    color: white;
    background:
      radial-gradient(circle at 12% 20%, rgba(197, 240, 77, 0.15), transparent 30%),
      linear-gradient(135deg, #0c2534 0%, #11283a 56%, #0c4749 100%);
    box-shadow: 0 28px 70px rgba(17, 40, 58, 0.16);
  }

  .instructor-card::after {
    content: "VC";
    position: absolute;
    right: -20px;
    bottom: -70px;
    color: rgba(255, 255, 255, 0.035);
    font-size: clamp(12rem, 24vw, 22rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.12em;
    pointer-events: none;
  }

  .portrait-column,
  .instructor-copy {
    position: relative;
    z-index: 1;
  }

  .portrait-column {
    display: grid;
    justify-items: center;
    gap: 12px;
  }

  .portrait-frame {
    width: min(100%, 300px);
    aspect-ratio: 1;
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 55px rgba(2, 17, 25, 0.34);
  }

  .portrait-frame img,
  .guest-portrait img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 50%;
  }

  .portrait-frame img { background: #e7e9e6; }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #dbe7ea;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .availability i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 5px rgba(197, 240, 77, 0.12);
  }

  .role {
    margin: 0;
    color: var(--lime);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .instructor-copy h3 {
    margin: 8px 0 0;
    font-family: inherit;
    font-size: clamp(2.6rem, 4vw, 4rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .pronunciation {
    margin: 10px 0 0;
    color: #a9bcc4;
    font-size: 0.82rem;
  }

  .pronunciation strong { color: white; }

  .bio {
    max-width: 670px;
    margin: 12px 0 10px;
    color: #c5d2d7;
    font-size: 1rem;
    line-height: 1.45;
  }

  .research-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .research-tags span {
    padding: 8px 11px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: #dbe5e8;
    font-size: 0.66rem;
    font-weight: 700;
  }

  .instructor-details {
    margin: 14px 0 0;
    display: grid;
    grid-template-columns: 0.9fr 0.7fr 1.4fr;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .instructor-details div { min-width: 0; padding: 8px 16px 8px 0; }
  .instructor-details div + div { padding-left: 16px; border-left: 1px solid rgba(255, 255, 255, 0.16); }
  .instructor-details dt,
  .guest-event dt {
    color: #849ca6;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .instructor-details dt { margin-bottom: 7px; }
  .instructor-details dd { margin: 0; color: white; font-size: 0.78rem; line-height: 1.5; }
  .instructor-details a:hover { color: var(--lime); }

  .instructor-actions,
  .guest-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .instructor-actions { margin-top: 14px; gap: 22px; }
  .guest-actions { margin-top: 22px; gap: 18px; }

  .profile-button {
    min-height: 42px;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    border-radius: 999px;
    color: var(--ink);
    background: var(--lime);
    font-size: 0.76rem;
    font-weight: 800;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .profile-button:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(197, 240, 77, 0.18); }
  .profile-button svg { width: 1rem; fill: none; stroke: currentColor; stroke-width: 1.7; }

  .university-link,
  .guest-link {
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .university-link { color: #d7e2e5; border-color: rgba(255, 255, 255, 0.35); }
  .university-link:hover { color: var(--lime); border-color: var(--lime); }

  /* Guest speaker spotlight */
  .guest-heading { margin: clamp(72px, 9vw, 112px) 0 28px; }
  .guest-heading h2 { margin: 8px 0 0; color: var(--ink); }

  .guest-card {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr) minmax(245px, 0.48fr);
    gap: clamp(24px, 3vw, 42px);
    align-items: center;
    padding: clamp(24px, 3vw, 38px);
    border: 1px solid rgba(13, 124, 124, 0.28);
    border-radius: 24px;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 18px 48px rgba(6, 43, 69, 0.1);
  }

  .guest-portrait {
    position: relative;
    width: 168px;
    aspect-ratio: 1;
    justify-self: center;
    padding: 7px;
    border: 1px solid rgba(6, 43, 69, 0.14);
    border-radius: 50%;
    background: #eef1ec;
  }

  .upcoming {
    position: absolute;
    left: 50%;
    bottom: -8px;
    transform: translateX(-50%);
    padding: 8px 16px;
    border-radius: 999px;
    color: var(--ink);
    background: var(--lime);
    box-shadow: 0 8px 18px rgba(6, 43, 69, 0.12);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .guest-copy h3 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .guest-affiliation { margin: 10px 0 22px; color: #087675; font-size: 0.88rem; font-weight: 700; }
  .guest-copy h4 { margin: 0 0 10px; font-size: clamp(1.05rem, 1.5vw, 1.3rem); line-height: 1.3; }
  .guest-bio { max-width: 670px; margin: 0; color: #53666f; font-size: 0.9rem; line-height: 1.65; }

  .guest-event {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: clamp(24px, 3vw, 40px);
    border-left: 1px solid rgba(6, 43, 69, 0.16);
  }

  .guest-event dl { margin: 0; display: grid; gap: 14px; }
  .guest-event dl div { display: grid; grid-template-columns: 72px 1fr; gap: 10px; align-items: baseline; }
  .guest-event dt { margin: 0; }
  .guest-event dd { margin: 0; color: var(--ink); font-size: 0.9rem; font-weight: 750; }
  .guest-link { color: var(--ink); }
  .guest-link:hover { color: #087675; }

  @media (max-width: 1000px) {
    .guest-card { grid-template-columns: 170px 1fr; }
    .guest-event {
      grid-column: 1 / -1;
      padding: 24px 0 0;
      border-top: 1px solid rgba(6, 43, 69, 0.16);
      border-left: 0;
    }
    .guest-event dl { grid-template-columns: repeat(3, 1fr); }
    .guest-event dl div { display: block; }
    .guest-event dd { margin-top: 6px; }
  }

  @media (max-width: 900px) {
    .instructor-card { grid-template-columns: 1fr; }
    .portrait-frame { width: min(180px, 52vw); }
    .instructor-copy { text-align: center; }
    .bio { margin-left: auto; margin-right: auto; }
    .research-tags,
    .instructor-actions { justify-content: center; }
    .instructor-details { text-align: left; }
  }

  @media (max-width: 650px) {
    .instructor { width: min(100% - 28px, 1320px); padding: 82px 0; }
    .instructor-card { gap: 18px; padding: 18px 20px; border-radius: 20px; }
    .instructor-details { grid-template-columns: 1fr; }
    .instructor-details div,
    .instructor-details div + div { padding: 11px 0; border-left: 0; }
    .instructor-details div + div { border-top: 1px solid rgba(255, 255, 255, 0.12); }
    .instructor-actions { align-items: stretch; flex-direction: column; gap: 16px; }

    .guest-heading { margin-top: 72px; }
    .guest-card { grid-template-columns: 1fr; padding: 26px 20px; text-align: center; }
    .guest-portrait { width: 150px; }
    .guest-affiliation { margin-bottom: 18px; }
    .guest-event { grid-column: auto; padding-top: 22px; }
    .guest-event dl { grid-template-columns: 1fr; gap: 12px; }
    .guest-actions { flex-direction: column; align-items: stretch; }
    .guest-link { align-self: center; }
  }
</style>
