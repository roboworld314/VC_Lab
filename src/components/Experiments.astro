---
const experiments = [
  {
    index: "E / 01",
    status: "Active",
    statusClass: "active",
    title: "Autonomous Vehicle Lane Detection and Route Planning",
description:
  "Camera-based perception detects lane boundaries and road markings in real time, enabling the vehicle to plan safe routes, follow lanes, and respond accurately to changing track conditions.",
tags: ["Lane Detection", "Route Planning", "Autonomous Driving"],
    // metric: "3.4×",
    // metricLabel: "lower planning delay",
    mediaType: "video",
    mediaSrcs: [
      "https://drive.google.com/file/d/1fwhq6onGvsBUNFP7ZJI_Yu9-09Pl-F7E/preview",
      "https://drive.google.com/file/d/1fwhq6onGvsBUNFP7ZJI_Yu9-09Pl-F7E/preview",
    ],
    mediaLabel: "SenseGuard experiment video",
  },
  {
    index: "E / 02",
    status: "Active",
    statusClass: "active",
    title: "Obstacle Detection and Tracking",
    description:
    "The system detects and tracks nearby vehicles, pedestrians, and other obstacles in real time using onboard camera data. Continuous position and motion estimates help the autonomous vehicle maintain a safe path and respond quickly to changing surroundings.",
    tags: ["Object Detection", "Multi-Object Tracking", "Collision Avoidance"],
    metric: "92.3%",
    metricLabel: "blind-zone detection",
    mediaType: "image",
    mediaSrc: "https://lh3.googleusercontent.com/d/1J_BjOpYJwN7ZVhTn1hiGHkBT1WQkqpal",
    mediaLabel: "Vehicle computing lab outdoor experiment",
  },
];
---

<section class="experiments section-shell" id="experiments">
  <div class="section-heading-row">
    <div>
      <p class="section-kicker">Now in the lab</p>
      <h2>Ongoing experiments.</h2>
    </div>
    <p>Live research spanning the full sensor-to-decision pipeline.</p>
  </div>

  <div class="experiment-showcase-list">
    {experiments.map((experiment) => (
      <article class:list={["experiment-showcase", { "video-showcase": experiment.mediaType === "video" }]}>
        {experiment.mediaType === "video" ? (
          <div class="experiment-video-slots">
            {experiment.mediaSrcs.map((mediaSrc, mediaIndex) => (
              <div class="experiment-video-slot">
                <iframe
                  src={mediaSrc}
                  title={`${experiment.mediaLabel} ${mediaIndex + 1}`}
                  loading="lazy"
                  allow="autoplay; fullscreen"
                  allowfullscreen
                />
                <p class="video-caption">Experiment video {mediaIndex + 1}</p>
              </div>
            ))}
          </div>
        ) : (
          <div class="experiment-media">
            <img
              src={experiment.mediaSrc}
              alt={experiment.mediaLabel}
              loading="lazy"
              width="1200"
              height="800"
            />
            <div class="media-caption">
              <span class="media-icon" aria-hidden="true">◫</span>
              <span>Field image</span>
            </div>
          </div>
        )}

        <div class="experiment-details">
          <div class="experiment-topline">
            <span class="experiment-index">{experiment.index}</span>
            <span class:list={["status", experiment.statusClass]}>{experiment.status}</span>
          </div>

          <h3>{experiment.title}</h3>
          <p>{experiment.description}</p>

          <div class="experiment-tags" aria-label="Research areas">
            {experiment.tags.map((tag) => <span>{tag}</span>)}
          </div>

          {experiment.metric && (
            <div class="experiment-metric">
              <strong>{experiment.metric}</strong>
              <span>{experiment.metricLabel}</span>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .experiment-showcase-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem;
  }

  .experiment-showcase {
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--white);
    box-shadow: 0 18px 50px rgba(17, 40, 58, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .experiment-showcase:first-child {
    grid-column: 1 / -1;
  }

  .video-showcase {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
  }

  .video-showcase .experiment-details {
    order: -1;
    width: 100%;
    background: var(--white);
    padding-bottom: 30px;
  }

  .video-showcase .experiment-details > p {
    width: 100%;
    max-width: none;
  }

  .video-showcase h3 {
    max-width: none;
    white-space: nowrap;
  }

  .experiment-showcase:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px rgba(17, 40, 58, 0.11);
  }

  .experiment-media {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: #081d29;
  }

  .experiment-video-slots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
  }

  .experiment-video-slot {
    position: relative;
    min-width: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #081d29;
  }

  .experiment-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 58%, rgba(5, 22, 31, 0.68));
  }

  .experiment-media img,
  .experiment-video-slot iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    object-fit: cover;
  }

  .video-caption {
    position: absolute;
    z-index: 1;
    left: 14px;
    bottom: 12px;
    margin: 0;
    padding: 6px 9px;
    color: white;
    background: rgba(8, 29, 41, 0.72);
    border-radius: 4px;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .media-caption {
    position: absolute;
    z-index: 1;
    left: 20px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: white;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .media-icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 50%;
    background: rgba(8, 29, 41, 0.62);
    backdrop-filter: blur(8px);
    font-size: 0.7rem;
  }

  .media-icon.video {
    padding-left: 2px;
    color: var(--lime);
  }

  .experiment-details {
    position: relative;
    padding: clamp(26px, 3.5vw, 44px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .experiment-topline {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .experiment-index {
    padding: 0;
  }

  .status {
    margin: 0;
  }

  h3 {
    max-width: 570px;
    margin: 26px 0 0;
    font-size: clamp(1.75rem, 2.8vw, 2.65rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .experiment-details > p {
    max-width: 620px;
    margin: 18px 0 22px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .experiment-metric {
    width: 100%;
    margin-top: auto;
    padding: 24px 0 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
    text-align: left;
    border-top: 1px solid var(--line);
  }

  .experiment-metric strong,
  .experiment-metric span {
    display: inline;
  }

  .experiment-metric strong {
    font-size: clamp(1.8rem, 3vw, 2.45rem);
  }

  .experiment-metric span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .experiment-showcase-list {
      grid-template-columns: 1fr;
    }

    .experiment-media {
      min-height: 300px;
      aspect-ratio: 16 / 9;
    }

    .video-showcase {
      grid-template-columns: 1fr;
    }

    .video-showcase h3 {
      white-space: normal;
    }

    .experiment-video-slot {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 600px) {
    .experiment-showcase {
      min-height: 0;
      border-radius: 18px;
    }

    .experiment-media {
      min-height: 0;
    }

    .experiment-details {
      padding: 28px 24px 30px;
    }

    h3 {
      margin-top: 22px;
    }

    .experiment-metric {
      align-items: flex-start;
      flex-direction: column;
      gap: 3px;
    }
  }
</style>
