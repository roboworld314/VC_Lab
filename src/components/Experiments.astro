---
const experiments = [
  {
    index: "E / 01",
    status: "Active",
    statusClass: "active",
    title: "Autonomous Driving lane detection and planning",
    description:
      "Adaptive selection keeps decision-critical camera and LiDAR evidence fresh under constrained onboard compute, helping the vehicle react sooner without processing every frame.",
    tags: ["Edge AI", "Sensor fusion", "Scheduling"],
    metric: "3.4×",
    metricLabel: "lower planning delay",
    mediaType: "video",
    mediaSrc: "https://drive.google.com/file/d/1BV0f012GT49ySYrE-zComIcFRSKspdmL/preview",
    mediaLabel: "SenseGuard experiment video",
  },
  {
    index: "E / 02",
    status: "Active",
    statusClass: "active",
    title: "Cooperative blind-zone awareness",
    description:
      "Roadside sensing and V2I communication help vehicles reason about pedestrians and traffic hidden from onboard cameras, extending perception beyond the vehicle's direct line of sight.",
    tags: ["V2I", "Perception", "Safety"],
    metric: "92.3%",
    metricLabel: "blind-zone detection",
    mediaType: "image",
    mediaSrc: "https://lh3.googleusercontent.com/d/1J_BjOpYJwN7ZVhTn1hiGHkBT1WQkqpal",
    mediaLabel: "Vehicle computing lab outdoor experiment",
  },
];
---

<section class="experiments section-shell" id="experiments">
  <div class="section-heading-row">
    <div>
      <p class="section-kicker">Now in the lab</p>
      <h2>Ongoing experiments.</h2>
    </div>
    <p>Live research spanning the full sensor-to-decision pipeline.</p>
  </div>

  <div class="experiment-showcase-list">
    {experiments.map((experiment) => (
      <article class="experiment-showcase">
        <div class="experiment-media">
          {experiment.mediaType === "video" ? (
            <iframe
              src={experiment.mediaSrc}
              title={experiment.mediaLabel}
              loading="lazy"
              allow="autoplay; fullscreen"
              allowfullscreen
            />
          ) : (
            <img
              src={experiment.mediaSrc}
              alt={experiment.mediaLabel}
              loading="lazy"
              width="1200"
              height="800"
            />
          )}
          <div class="media-caption">
            <span class:list={["media-icon", { video: experiment.mediaType === "video" }]} aria-hidden="true">
              {experiment.mediaType === "video" ? "▶" : "◫"}
            </span>
            <span>{experiment.mediaType === "video" ? "Experiment video" : "Field image"}</span>
          </div>
        </div>

        <div class="experiment-details">
          <div class="experiment-topline">
            <span class="experiment-index">{experiment.index}</span>
            <span class:list={["status", experiment.statusClass]}>{experiment.status}</span>
          </div>

          <h3>{experiment.title}</h3>
          <p>{experiment.description}</p>

          <div class="experiment-tags" aria-label="Research areas">
            {experiment.tags.map((tag) => <span>{tag}</span>)}
          </div>

          <div class="experiment-metric">
            <strong>{experiment.metric}</strong>
            <span>{experiment.metricLabel}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .experiment-showcase-list {
    display: grid;
    gap: 1.35rem;
  }

  .experiment-showcase {
    min-height: 250px;
    display: grid;
    grid-template-columns: minmax(320px, 0.95fr) minmax(0, 1.05fr);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--white);
    box-shadow: 0 18px 50px rgba(17, 40, 58, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .experiment-showcase:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px rgba(17, 40, 58, 0.11);
  }

  .experiment-media {
    position: relative;
    min-height: 350px;
    overflow: hidden;
    background: #081d29;
  }

  .experiment-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 58%, rgba(5, 22, 31, 0.68));
  }

  .experiment-media iframe,
  .experiment-media img {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    object-fit: cover;
  }

  .media-caption {
    position: absolute;
    z-index: 1;
    left: 20px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: white;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .media-icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 50%;
    background: rgba(8, 29, 41, 0.62);
    backdrop-filter: blur(8px);
    font-size: 0.7rem;
  }

  .media-icon.video {
    padding-left: 2px;
    color: var(--lime);
  }

  .experiment-details {
    position: relative;
    padding: clamp(30px, 4vw, 52px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .experiment-topline {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .experiment-index {
    padding: 0;
  }

  .status {
    margin: 0;
  }

  h3 {
    max-width: 570px;
    margin: 26px 0 0;
    font-size: clamp(1.75rem, 2.8vw, 2.65rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .experiment-details > p {
    max-width: 620px;
    margin: 18px 0 22px;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .experiment-metric {
    width: 100%;
    margin-top: auto;
    padding: 24px 0 0;
    display: flex;
    align-items: baseline;
    gap: 12px;
    text-align: left;
    border-top: 1px solid var(--line);
  }

  .experiment-metric strong,
  .experiment-metric span {
    display: inline;
  }

  .experiment-metric strong {
    font-size: clamp(1.8rem, 3vw, 2.45rem);
  }

  .experiment-metric span {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .experiment-showcase {
      grid-template-columns: 1fr;
    }

    .experiment-media {
      min-height: 300px;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 600px) {
    .experiment-showcase {
      min-height: 0;
      border-radius: 18px;
    }

    .experiment-media {
      min-height: 220px;
    }

    .experiment-details {
      padding: 28px 24px 30px;
    }

    h3 {
      margin-top: 22px;
    }

    .experiment-metric {
      align-items: flex-start;
      flex-direction: column;
      gap: 3px;
    }
  }
</style>
