---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const logoDevToken = import.meta.env.PUBLIC_LOGO_DEV_TOKEN;
const wmLogoSrc = logoDevToken
  ? `https://img.logo.dev/wm.edu?token=${encodeURIComponent(logoDevToken)}&size=160&format=png&retina=true`
  : `${base}images/william-mary-logo.png`;
---

<header class="site-header">
  <div class="header-branding">
    <a
      class="wm-brand"
      href="https://www.wm.edu/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="William & Mary website"
    >
      <img
        class="wm-logo"
        src={wmLogoSrc}
        alt="William & Mary"
      />
    </a>

    <span class="brand-divider" aria-hidden="true"></span>

    <a class="brand" href="#top" aria-label="Vehicle Computing Lab home">
      <img
        class="brand-logo"
        src={`${base}images/lab-logo.jpg`}
        alt="Vehicle Computing Lab logo"
        width="528"
        height="395"
      />

      <span class="brand-text">
        <strong>Vehicle Computing Lab</strong>
        <small>William &amp; Mary</small>
      </span>
    </a>
  </div>

  <nav aria-label="Primary navigation">
    <a href="#instructor">Instructor</a>
    <a href="#platforms">Platforms</a>
    <a href="#experiments">Experiments</a>
    <a href="#testbed">Testbed</a>
    <a href="#demos">Demos</a>
  </nav>
</header>
