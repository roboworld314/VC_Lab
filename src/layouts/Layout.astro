---
import '../styles/global.css';

const title = 'Vehicle Computing Lab | William & Mary';
const description = 'Researching dependable autonomous vehicles, edge AI, connected infrastructure, and real-world vehicle computing systems.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImage = Astro.site
  ? new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11283a" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Vehicle Computing Lab" />
    <meta property="og:description" content="Systems · Autonomy · Edge AI" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Vehicle Computing Lab" />
    <meta name="twitter:description" content="Systems · Autonomy · Edge AI" />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body><slot /></body>
</html>
