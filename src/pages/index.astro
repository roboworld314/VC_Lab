---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProblemStatement from '../components/ProblemStatement.astro';
import ImageShowcase from '../components/ImageShowcase.astro';
import ContentParagraphs from '../components/ContentParagraphs.astro';
import Datacollection from '../components/Datacollection.astro';
import DemoVideo from '../components/DemoVideo.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'SenseGuard';
const pageDescription =
  'Sensor-to-decision adaptation for reliable agentic AI robots under vibration and resource constraints.';
---

<Layout title={pageTitle} description={pageDescription}>
  <a class="skip-link" href="#problem-statement">Skip to main content</a>

  <Hero />
  <ProblemStatement />
  <ImageShowcase />
  <ContentParagraphs />
  <Datacollection />
  <DemoVideo />
  <Footer />
</Layout>

<style>
  .skip-link {
    position: fixed;
    z-index: 1000;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    color: #152942;
    background: #c8ee57;
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
    transform: translateY(-150%);
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link { transition: none; }
  }
</style>
