---
import Layout from '../layouts/Layout.astro';

const arrow = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"></path></svg>';
---

<Layout>
  <main>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Vehicle Computing Lab home">
        <span class="brand-mark">VC</span>
        <span><strong>Vehicle Computing Lab</strong><small>William &amp; Mary</small></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#platforms">Platforms</a>
        <a href="#experiments">Experiments</a>
        <a href="#testbed">Testbed</a>
        <a href="#demos">Demos</a>
      </nav>
    </header>

    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Systems · Autonomy · Edge AI</p>
        <h1>Building dependable intelligence for <em>vehicles in motion.</em></h1>
        <p class="hero-lede">We study how autonomous vehicles sense, compute, communicate, and decide in real time—then validate those ideas on physical vehicles and full-scale indoor testbeds.</p>
        <div class="hero-actions">
          <a class="button primary" href="#experiments">Explore our experiments <Fragment set:html={arrow} /></a>
          <a class="button secondary" href="#platforms">Meet the fleet</a>
        </div>
        <dl class="quick-stats" aria-label="Lab at a glance">
          <div><dt>06</dt><dd>Research vehicles</dd></div>
          <div><dt>42 m²</dt><dd>Indoor road testbed</dd></div>
          <div><dt>5G + Wi-Fi 7</dt><dd>Connected infrastructure</dd></div>
        </dl>
      </div>

      <div class="hero-visual" aria-label="Vehicle Computing Lab test vehicle">
        <img src="https://lh3.googleusercontent.com/d/1Tc_J8SAASOFz-OovA0bAbX3_7NNMOSZW" alt="Autonomous robotic vehicle used in the Vehicle Computing Lab" width="1000" height="800" />
        <div class="visual-shade"></div>
        <div class="live-chip"><i></i> Active testbed</div>
        <div class="visual-note"><span>Physical autonomy stack</span><strong>Perception → Planning → Control</strong></div>
      </div>
    </section>

    <section class="mission section-shell">
      <div><p class="section-kicker">Our mission</p><h2>Research that survives the gap between simulation and the road.</h2></div>
      <p>Vehicle intelligence is only useful when it remains timely, efficient, and safe outside a controlled benchmark. Our lab brings computing systems, wireless networks, and embodied AI together in one reproducible experimental environment.</p>
    </section>

    <section class="platforms" id="platforms">
      <div class="section-shell">
        <div class="section-heading-row">
          <div><p class="section-kicker">Research platforms</p><h2>Meet the fleet.</h2></div>
          <p>Multiple vehicle classes let us move from fast iteration to realistic, repeatable validation.</p>
        </div>
        <div class="fleet-grid">
          <article class="fleet-card featured">
            <img src="https://lh3.googleusercontent.com/d/1_TBdIG1UbyEB6tQ_wzuksS9Ima-5Tifo" alt="ROSMASTER research vehicle in the indoor testbed" width="1200" height="800" loading="lazy" />
            <div class="fleet-overlay"><span class="number">01</span><div><p>Omnidirectional platform</p><h3>ROSMASTER X3</h3></div><span class="tag">Jetson Orin NX</span></div>
          </article>
          <article class="fleet-card">
            <div class="fleet-art r2-art"><span>R2</span></div>
            <div class="fleet-copy"><span class="number">02</span><p>Ackermann steering</p><h3>ROSMASTER R2</h3><span class="tag dark">Vehicle control</span></div>
          </article>
          <article class="fleet-card">
            <div class="fleet-art sim-art"><span>SIM</span></div>
            <div class="fleet-copy"><span class="number">03</span><p>Digital proving ground</p><h3>CARLA + Driving Rig</h3><span class="tag dark">Repeatable scenarios</span></div>
          </article>
        </div>
      </div>
    </section>

    <section class="experiments section-shell" id="experiments">
      <div class="section-heading-row"><div><p class="section-kicker">Now in the lab</p><h2>Ongoing experiments.</h2></div><p>Live research spanning the full sensor-to-decision pipeline.</p></div>
      <div class="experiment-list">
        <article>
          <div class="experiment-index">E / 01</div>
          <div class="experiment-main"><span class="status active">Active</span><h3>Fresh, efficient sensing at the edge</h3><p>Adaptive selection keeps decision-critical camera and LiDAR evidence fresh under constrained onboard compute.</p><div class="experiment-tags"><span>Edge AI</span><span>Sensor fusion</span><span>Scheduling</span></div></div>
          <div class="experiment-metric"><strong>3.4×</strong><span>lower planning delay</span></div>
        </article>
        <article>
          <div class="experiment-index">E / 02</div>
          <div class="experiment-main"><span class="status active">Active</span><h3>Cooperative blind-zone awareness</h3><p>Roadside sensing and V2I communication help vehicles reason about pedestrians and traffic hidden from onboard cameras.</p><div class="experiment-tags"><span>V2I</span><span>Perception</span><span>Safety</span></div></div>
          <div class="experiment-metric"><strong>92.3%</strong><span>blind-zone detection</span></div>
        </article>
        <article>
          <div class="experiment-index">E / 03</div>
          <div class="experiment-main"><span class="status validating">Validating</span><h3>Failure-aware vehicle data systems</h3><p>Context-aware logging retains compact, high-value evidence around perception and control failures.</p><div class="experiment-tags"><span>Data systems</span><span>Reliability</span><span>Black box</span></div></div>
          <div class="experiment-metric"><strong>32%</strong><span>storage saved</span></div>
        </article>
      </div>
    </section>

    <section class="testbed" id="testbed">
      <div class="section-shell testbed-grid">
        <div class="testbed-copy">
          <p class="section-kicker light">Connected testbed</p>
          <h2>One lab.<br />Every layer.</h2>
          <p>We instrument vehicles, roads, networks, and edge computers together—so a systems idea can be measured end to end.</p>
          <div class="stack-list">
            <div><span>01</span><strong>Vehicle layer</strong><small>RGB cameras · IMU · LiDAR · CAN</small></div>
            <div><span>02</span><strong>Roadside layer</strong><small>4 RGB cameras · 3D LiDAR · RSU</small></div>
            <div><span>03</span><strong>Network layer</strong><small>5G NR · Wi-Fi 7 · V2X</small></div>
            <div><span>04</span><strong>Compute layer</strong><small>Jetson Orin · Edge servers · GPU cluster</small></div>
          </div>
        </div>
        <div class="testbed-media">
          <img src="https://lh3.googleusercontent.com/d/1J_BjOpYJwN7ZVhTn1hiGHkBT1WQkqpal" alt="Vehicle Computing Lab outdoor vehicle experiment" width="1000" height="800" loading="lazy" />
          <div class="map-card"><span>Indoor map</span><strong>6 m × 7 m</strong><small>lanes · crosswalks · parking · signs</small></div>
        </div>
      </div>
    </section>

    <section class="demos section-shell" id="demos">
      <div class="section-heading-row">
        <div><p class="section-kicker">See it run</p><h2>Experiment demo.</h2></div>
        <a class="text-link" href="https://drive.google.com/file/d/1wWTNAS4955ns9qfJYYPXwjy6jgHvF9V2/view" target="_blank" rel="noopener noreferrer">Open full video <Fragment set:html={arrow} /></a>
      </div>
      <div class="demo-grid">
        <div class="video-frame"><iframe src="https://drive.google.com/file/d/1BV0f012GT49ySYrE-zComIcFRSKspdmL/preview" allow="autoplay; fullscreen" loading="lazy" title="Vehicle computing experiment demo"></iframe></div>
        <div class="demo-copy"><span>Featured system</span><h3>SenseGuard</h3><p>Adaptive sensor-to-decision computing under vibration and resource constraints.</p><ul><li>Prioritizes informative sensor data</li><li>Reduces redundant storage</li><li>Preserves critical failure evidence</li></ul></div>
      </div>
    </section>

    <footer>
      <div class="footer-inner"><div><span class="brand-mark">VC</span><h2>Let’s move vehicle computing forward.</h2></div><p>Vehicle Computing Lab<br />William &amp; Mary · Williamsburg, Virginia</p></div>
      <div class="footer-bottom"><span>© 2026 Vehicle Computing Lab</span><a href="#top">Back to top ↑</a></div>
    </footer>
  </main>
</Layout>
