---
const appendixUrl = "https://drive.google.com/file/d/1adc8mrF3CoUz2dJ_2IxYwd5p2cFx412H/view";
---

<section id="resources" class="resource-section" aria-labelledby="resources-title">
  <div class="resource-card">
    <div>
      <p class="section-kicker">Continue exploring</p>
      <h2 id="resources-title">Methods, experiments, and supporting results.</h2>
    </div>
    <div class="resource-actions">
      <a href={appendixUrl} target="_blank" rel="noopener noreferrer">
        Read the appendix
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <p>Code and dataset will be released following the review period.</p>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div>
    <strong>SenseGuard</strong>
    <p>Supplementary materials for anonymous review.</p>
  </div>
  <p>&copy; 2026 CAV Black Box</p>
</footer>

<style>
  .resource-section { padding: clamp(4rem, 8vw, 7rem) 1.5rem; background: #eef2ee; }
  .resource-card { width: min(1100px, 100%); margin: 0 auto; padding: clamp(2rem, 5vw, 4rem); display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 3rem; align-items: end; border-radius: 22px; color: #fff; background: #0f716b; }
  .section-kicker { margin: 0 0 0.9rem; color: #d8f59a; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  h2 { margin: 0; max-width: 650px; font-family: var(--font-heading, Georgia, serif); font-size: clamp(2.3rem, 4.4vw, 4rem); font-weight: 400; line-height: 1; letter-spacing: -0.045em; }
  .resource-actions a { min-height: 48px; padding: 0 1.1rem; display: inline-flex; justify-content: space-between; align-items: center; gap: 2rem; border-radius: 999px; color: #152942; background: #c8ee57; font-size: 0.78rem; font-weight: 800; text-decoration: none; }
  .resource-actions svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .resource-actions p { max-width: 310px; margin: 1rem 0 0; color: #c7e1dd; font-size: 0.75rem; line-height: 1.6; }
  .site-footer { padding: 2rem max(1.5rem, calc((100vw - 1100px) / 2)); display: flex; justify-content: space-between; align-items: end; gap: 2rem; color: #a9bac3; background: #091c29; }
  .site-footer strong { color: #fff; }
  .site-footer p { margin: 0.35rem 0 0; font-size: 0.72rem; }
  @media (max-width: 700px) { .resource-card { grid-template-columns: 1fr; } .site-footer { align-items: flex-start; flex-direction: column; } }
</style>
